# Copy to .env and fill in real values before running `docker compose up`.
# .env is gitignored — never commit real secrets.

# Required. Signs and verifies JWTs (appmiddleware.NewAuthService). Generate
# with e.g. `openssl rand -base64 32`. main.go falls back to a dev-only
# default when unset outside Docker, but docker-compose.yml refuses to start
# without this set explicitly.
JWT_SECRET=

# Optional. Host port the API is published on (container always listens on 8080).
PORT=8080
